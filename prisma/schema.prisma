generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum FincaStatus {
  ACTIVE
  INACTIVE
  VERIFIED
}

enum AnimalType {
  INDIVIDUAL
  LOT
}

enum AnimalSex {
  MALE
  FEMALE
  MIXED
  UNKNOWN
}

enum AnimalStatus {
  AVAILABLE
  RESERVED
  SOLD
  INACTIVE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageType {
  TEXT
  SYSTEM
}

enum ImageType {
  PRIMARY
  GALLERY
  DOCUMENT
}

enum NotificationType {
  MESSAGE
  RESERVATION_REQUEST
  RESERVATION_CONFIRMED
  RESERVATION_REJECTED
  RESERVATION_CANCELLED
  RESERVATION_COMPLETED
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  emailVerified DateTime?
  image         String?
  phone         String?    @db.VarChar(30)
  passwordHash  String?
  status        UserStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles                 UserRole[]
  finca                 Finca[]
  reservationsAsBuyer   Reservation[]  @relation("ReservationBuyer")
  reservationsAsSeller  Reservation[]  @relation("ReservationSeller")
  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  sentMessages          Message[]      @relation("MessageSender")
  receivedMessages      Message[]      @relation("MessageRecipient")
  images                Image[]        @relation("UserImages")
  accounts              Account[]
  sessions              Session[]
  favorites             Favorite[]
  notifications         Notification[]
  passwordResetTokens   PasswordResetToken[]

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users UserRole[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Department {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @unique
  code           String         @unique @db.VarChar(10)
  municipalities Municipality[]
  fincas         Finca[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Municipality {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  code         String @db.VarChar(10)
  departmentId String @db.Uuid

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  fincas     Finca[]

  @@unique([departmentId, name])
  @@unique([departmentId, code])
  @@unique([id, departmentId])
  @@index([departmentId])
}

model Finca {
  id             String      @id @default(uuid()) @db.Uuid
  ownerId        String      @db.Uuid
  departmentId   String      @db.Uuid
  municipalityId String      @db.Uuid
  name           String
  description    String?
  address        String?
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  status         FincaStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  municipality Municipality @relation(fields: [municipalityId, departmentId], references: [id, departmentId], onDelete: Restrict)
  animals      Animal[]
  images       Image[]      @relation("FincaImages")
  profileVisits ProfileVisit[]

  @@index([ownerId])
  @@index([departmentId])
  @@index([municipalityId])
  @@index([status])
}

model ProfileVisit {
  id             String   @id @default(uuid()) @db.Uuid
  fincaId        String   @db.Uuid
  visitorKeyHash String
  visitedAt      DateTime @default(now())
  visitDay       DateTime @db.Date

  finca Finca @relation(fields: [fincaId], references: [id], onDelete: Cascade)

  @@unique([fincaId, visitorKeyHash, visitDay])
  @@index([fincaId, visitedAt])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  parentId    String?  @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  animals  Animal[]

  @@index([parentId])
  @@index([isActive])
}

model Animal {
  id                   String       @id @default(uuid()) @db.Uuid
  fincaId              String       @db.Uuid
  categoryId           String       @db.Uuid
  type                 AnimalType   @default(INDIVIDUAL)
  identifier           String?
  name                 String?
  sex                  AnimalSex    @default(UNKNOWN)
  breed                String?
  birthDate            DateTime?
  approximateAgeMonths Int?
  weightKg             Decimal?     @db.Decimal(10, 2)
  quantity             Int          @default(1)
  price                Decimal      @db.Decimal(12, 2)
  currency             String       @default("NIO") @db.VarChar(3)
  description          String?
  healthStatus         String?
  vaccinationInfo      String?
  status               AnimalStatus @default(AVAILABLE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  finca            Finca             @relation(fields: [fincaId], references: [id], onDelete: Restrict)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           Image[]           @relation("AnimalImages")
  reservationItems ReservationItem[]
  conversations    Conversation[]
  favorites        Favorite[]

  @@unique([fincaId, identifier])
  @@index([fincaId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@index([sex])
}

model Image {
  id        String    @id @default(uuid()) @db.Uuid
  animalId  String?   @db.Uuid
  fincaId   String?   @db.Uuid
  userId    String?   @db.Uuid
  url       String
  publicId  String    @unique
  type      ImageType @default(GALLERY)
  altText   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  animal Animal? @relation("AnimalImages", fields: [animalId], references: [id], onDelete: Cascade)
  finca  Finca?  @relation("FincaImages", fields: [fincaId], references: [id], onDelete: Cascade)
  user   User?   @relation("UserImages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([fincaId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  animalId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([userId, animalId])
  @@index([animalId])
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  buyerId     String            @db.Uuid
  sellerId    String            @db.Uuid
  status      ReservationStatus @default(PENDING)
  message     String?
  totalAmount Decimal?          @db.Decimal(12, 2)
  currency    String            @default("NIO") @db.VarChar(3)
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  buyer  User              @relation("ReservationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller User              @relation("ReservationSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  items  ReservationItem[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

model ReservationItem {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @db.Uuid
  animalId      String   @db.Uuid
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  animal      Animal      @relation(fields: [animalId], references: [id], onDelete: Restrict)

  @@unique([reservationId, animalId])
  @@index([animalId])
}

model Conversation {
  id        String             @id @default(uuid()) @db.Uuid
  buyerId   String             @db.Uuid
  sellerId  String             @db.Uuid
  animalId  String?            @db.Uuid
  status    ConversationStatus @default(OPEN)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  buyer    User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller   User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  animal   Animal?   @relation(fields: [animalId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([animalId])
  @@index([status])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
  recipientId    String?     @db.Uuid
  type           MessageType @default(TEXT)
  content        String
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient    User?        @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([recipientId])
  @@index([readAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
